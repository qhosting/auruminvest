//@version=6
// ═══════════════════════════════════════════════════════════════════════════════
// 📊 AURUM VISION V35.4 [FINAL PATCH] - Pine Script v6 - 100% Sin Errores
// ═══════════════════════════════════════════════════════════════════════════════

strategy("Aurum Vision PRO V35.4 [FINAL PATCH]",
    overlay=true, 
    initial_capital=1000,
    default_qty_type=strategy.percent_of_equity,
    default_qty_value=1.0,
    commission_type=strategy.commission.percent, 
    commission_value=0.06,
    slippage=2,
    calc_on_every_tick=false)

// ═══════════════════════════════════════════════════════════════════════════════
// 📋 SECCIÓN 1: CONFIGURACIÓN
// ═══════════════════════════════════════════════════════════════════════════════

group_strat = "🎯 Estrategia (Scalping M5)"
inp_dist_puntos = input.int(35, "Distancia Zona H1 (Puntos)", minval=10, maxval=100, group=group_strat)
h1_lookback = input.int(20, "Periodo Zona Macro (H1)", minval=10, maxval=50, group=group_strat)
m15_ema_len = input.int(150, "Tendencia EMA (M15)", minval=50, maxval=200, group=group_strat)
adx_len = input.int(14, "ADX Periodo", minval=10, maxval=20, group=group_strat)
adx_min = input.int(25, "ADX Mínimo (Fuerza)", minval=20, maxval=40, group=group_strat)
m5_rsi_len = input.int(14, "Gatillo RSI (M5)", minval=9, maxval=21, group=group_strat)
rsi_ob = input.float(60.0, "RSI Sobrecompra", minval=55.0, maxval=80.0, step=1.0, group=group_strat)
rsi_os = input.float(40.0, "RSI Sobreventa", minval=20.0, maxval=45.0, step=1.0, group=group_strat)

group_fibo = "📐 Fibonacci & Trampa"
use_fibo = input.bool(true, "Mostrar Auto-Fibonacci", group=group_fibo)
fibo_len = input.int(100, "Periodo Lookback Fibo", minval=50, maxval=200, group=group_fibo)
fibo_update_bars = input.int(10, "Actualizar Fibo cada N barras", minval=5, maxval=50, group=group_fibo)
show_trap = input.bool(true, "⚠️ DIBUJAR TRAMPA AUTOMÁTICA", group=group_fibo)

group_time = "⏰ Horario & Sesgo"
inp_session = input.session("0700-1200", "Kill Zone (Hora NY)", group=group_time)
inp_use_time = input.bool(true, "Activar Filtro Horario", group=group_time)
inp_use_bias = input.bool(true, "Usar Filtro Daily Open", group=group_time)

group_risk = "💰 Gestión de Riesgo PRO"
risk_percent = input.float(1.0, "Riesgo por Trade (%)", minval=0.1, maxval=5.0, step=0.1, group=group_risk)
max_risk_per_day = input.float(3.0, "Riesgo Máx. Diario (%)", minval=1.0, maxval=10.0, step=0.5, group=group_risk)
use_dynamic_sizing = input.bool(true, "Position Sizing Dinámico", group=group_risk)
max_daily_trades = input.int(5, "Máx. Trades por Día", minval=1, maxval=20, group=group_risk)
max_consecutive_losses = input.int(3, "Máx. Pérdidas Consecutivas", minval=2, maxval=10, group=group_risk)
reduce_size_after_loss = input.bool(true, "Reducir Tamaño Tras Pérdida", group=group_risk)

group_exits = "🎯 Salidas Avanzadas"
sl_mult = input.float(1.5, "SL (x ATR)", minval=1.0, maxval=3.0, step=0.1, group=group_exits)
tp_ratio = input.float(2.0, "TP Ratio (R:R)", minval=1.5, maxval=4.0, step=0.5, group=group_exits)
use_trailing = input.bool(true, "✅ Trailing Stop Activo", group=group_exits)
trail_start = input.float(1.5, "Trailing desde (× ATR)", minval=1.0, maxval=3.0, step=0.5, group=group_exits)
trail_offset = input.float(1.0, "Trailing offset (× ATR)", minval=0.5, maxval=2.0, step=0.5, group=group_exits)
use_breakeven = input.bool(true, "✅ Break-even Automático", group=group_exits)
breakeven_mult = input.float(1.0, "Break-even en (× ATR)", minval=0.5, maxval=2.0, step=0.5, group=group_exits)
max_bars_in_trade = input.int(50, "Máx. Barras en Trade", minval=10, maxval=200, group=group_exits)

group_confluence = "🎚️ Sistema de Confluencia"
confluence_min = input.int(2, "Mínimo Score Confluencia", minval=1, maxval=4, group=group_confluence)
use_zone_filter = input.bool(true, "Usar Filtro Zonas H1", group=group_confluence)
use_rsi_filter = input.bool(true, "Usar Filtro RSI", group=group_confluence)
use_pattern_filter = input.bool(true, "Usar Filtro Patrones", group=group_confluence)
use_bias_filter = input.bool(true, "Usar Filtro Daily Bias", group=group_confluence)

group_alert = "📊 Dashboard & Alertas"
show_dashboard = input.bool(true, "Mostrar Dashboard", group=group_alert)
show_metrics = input.bool(true, "Mostrar Métricas Avanzadas", group=group_alert)

// ═══════════════════════════════════════════════════════════════════════════════
// 🎨 COLORES
// ═══════════════════════════════════════════════════════════════════════════════
var color COL_GOLD = #FFD700
var color COL_TREND = #00E5FF
var color COL_DAILY = #FF00FF
var color COL_WIN = color.new(color.green, 80)
var color COL_LOSS = color.new(color.red, 80)

// ═══════════════════════════════════════════════════════════════════════════════
// 🔧 FUNCIONES AUXILIARES
// ═══════════════════════════════════════════════════════════════════════════════
calc_adx(len) =>
    [di_plus, di_minus, adx] = ta.dmi(len, len)
    adx

calc_position_size(entry_price, sl_price, risk_pct) =>
    sl_distance = math.abs(entry_price - sl_price)
    if sl_distance <= syminfo.mintick * 10
        sl_distance := syminfo.mintick * 10
    position_pct = (risk_pct / (sl_distance / entry_price * 100))
    min_size = 0.1
    max_size = 10.0
    size = math.max(min_size, math.min(position_pct, max_size))
    size

cleanup_lines(arr, max_size) =>
    while array.size(arr) > max_size
        old_line = array.shift(arr)
        line.delete(old_line)

cleanup_boxes(arr, max_size) =>
    while array.size(arr) > max_size
        old_box = array.shift(arr)
        box.delete(old_box)

cleanup_labels(arr, max_size) =>
    while array.size(arr) > max_size
        old_label = array.shift(arr)
        label.delete(old_label)

safe_bool(val) =>
    not na(val) and val

// ═══════════════════════════════════════════════════════════════════════════════
// 📊 DATOS MULTI-TIMEFRAME
// ═══════════════════════════════════════════════════════════════════════════════

var float daily_open_confirmed = na
if ta.change(time("1D")) != 0
    daily_open_confirmed := open
d_open = na(daily_open_confirmed) ? open : daily_open_confirmed

[h1_low_safe, h1_high_safe] = request.security(syminfo.tickerid, "60", [ta.lowest(low[1], h1_lookback), ta.highest(high[1], h1_lookback)], lookahead=barmerge.lookahead_off, gaps=barmerge.gaps_off)
h1_low = na(h1_low_safe) ? low : h1_low_safe
h1_high = na(h1_high_safe) ? high : h1_high_safe

[m15_ema_safe, adx_val_safe] = request.security(syminfo.tickerid, "15", [ta.ema(close[1], m15_ema_len), calc_adx(adx_len)], lookahead=barmerge.lookahead_off, gaps=barmerge.gaps_off)
m15_ema = na(m15_ema_safe) ? close : m15_ema_safe
adx_val = na(adx_val_safe) ? 0.0 : adx_val_safe

rsi = ta.rsi(close, m5_rsi_len)
atr = ta.atr(14)
atr_safe = atr > 0 ? atr : syminfo.mintick * 100

// ═══════════════════════════════════════════════════════════════════════════════
// 📐 FIBONACCI
// ═══════════════════════════════════════════════════════════════════════════════

var float confirmed_f_high = na
var float confirmed_f_low = na
var float confirmed_lev_618 = na
var float confirmed_lev_500 = na
var float confirmed_lev_382 = na
var int last_fibo_update = 0
var bool is_uptrend_confirmed = false

curr_f_high = ta.highest(high[1], fibo_len)
curr_f_low = ta.lowest(low[1], fibo_len)

bars_since_fibo_update = bar_index - last_fibo_update

if bars_since_fibo_update >= fibo_update_bars or na(confirmed_f_high)
    confirmed_f_high := curr_f_high
    confirmed_f_low := curr_f_low
    
    f_range = confirmed_f_high - confirmed_f_low
    f_range_valid = f_range > (syminfo.mintick * 10)
    
    if f_range_valid
        is_uptrend_confirmed := close > m15_ema
        
        if is_uptrend_confirmed
            confirmed_lev_618 := confirmed_f_high - (f_range * 0.618)
            confirmed_lev_500 := confirmed_f_high - (f_range * 0.500)
            confirmed_lev_382 := confirmed_f_high - (f_range * 0.382)
        else
            confirmed_lev_618 := confirmed_f_low + (f_range * 0.618)
            confirmed_lev_500 := confirmed_f_low + (f_range * 0.500)
            confirmed_lev_382 := confirmed_f_low + (f_range * 0.382)
    
    last_fibo_update := bar_index

var line[] fibo_lines = array.new_line(0)
var label[] fibo_labels = array.new_label(0)

if use_fibo and barstate.islast and not na(confirmed_lev_618)
    line_618 = line.new(bar_index - 50, confirmed_lev_618, bar_index + 10, confirmed_lev_618, color=COL_GOLD, width=2, style=line.style_solid, extend=extend.right)
    array.push(fibo_lines, line_618)
    line_500 = line.new(bar_index - 50, confirmed_lev_500, bar_index + 10, confirmed_lev_500, color=color.gray, width=1, style=line.style_dashed, extend=extend.right)
    array.push(fibo_lines, line_500)
    line_382 = line.new(bar_index - 50, confirmed_lev_382, bar_index + 10, confirmed_lev_382, color=color.blue, width=1, style=line.style_dotted, extend=extend.right)
    array.push(fibo_lines, line_382)
    
    lbl = label.new(bar_index + 10, confirmed_lev_618, "Fibo 61.8% ✓", style=label.style_label_left, textcolor=COL_GOLD, color=color.new(color.black, 80), size=size.small)
    array.push(fibo_labels, lbl)
    
    cleanup_lines(fibo_lines, 20)
    cleanup_labels(fibo_labels, 10)

// ═══════════════════════════════════════════════════════════════════════════════
// 🪤 TRAMPA AUTOMÁTICA (LÓGICA BLINDADA)
// ═══════════════════════════════════════════════════════════════════════════════
var box trap_risk = na
var box trap_reward = na
var label trap_lbl = na

if show_trap and barstate.islast and not na(confirmed_lev_618)
    box.delete(trap_risk)
    box.delete(trap_reward)
    label.delete(trap_lbl)
    
    entry_price = confirmed_lev_618
    sl_price = d_open
    tp_price = is_uptrend_confirmed ? confirmed_f_high : confirmed_f_low
    
    // ✅ CORRECCIÓN DEFINITIVA: Inicializar bools en false
    bool cond_buy = false
    bool cond_sell = false

    // Validar datos antes de calcular lógica
    valid_data = not na(entry_price) and not na(sl_price) and not na(tp_price)

    if valid_data
        cond_buy := is_uptrend_confirmed and entry_price < tp_price and entry_price > sl_price
        cond_sell := not is_uptrend_confirmed and entry_price > tp_price and entry_price < sl_price

    // Ahora 'cond_buy' y 'cond_sell' son SIEMPRE true o false, nunca 'na'
    if cond_buy or cond_sell
        trap_risk := box.new(bar_index, entry_price, bar_index + 15, sl_price, bgcolor=color.new(color.red, 85), border_color=color.new(color.red, 50), border_style=line.style_dashed, border_width=1)
        trap_reward := box.new(bar_index, entry_price, bar_index + 15, tp_price, bgcolor=color.new(color.green, 85), border_color=color.new(color.green, 50), border_style=line.style_dashed, border_width=1)
        trap_txt = is_uptrend_confirmed ? "🪤 BUY LIMIT" : "🪤 SELL LIMIT"
        trap_lbl := label.new(bar_index + 10, entry_price, trap_txt, textcolor=color.white, color=color.new(color.blue, 30), style=label.style_label_left, size=size.small)

// ═══════════════════════════════════════════════════════════════════════════════
// 🎯 FILTROS Y PATRONES
// ═══════════════════════════════════════════════════════════════════════════════
dist_price = inp_dist_puntos * syminfo.mintick
zona_soporte = math.abs(close - h1_low) <= dist_price
zona_resist = math.abs(close - h1_high) <= dist_price
mercado_vivo = adx_val > adx_min

in_session = true
if inp_use_time and timeframe.isintraday
    session_time = time(timeframe.period, inp_session, "America/New_York")
    in_session := not na(session_time)

bgcolor(inp_use_time and in_session ? color.new(color.blue, 95) : na, title="Horario NY")

body = math.abs(close - open)
upper_wick = high - math.max(open, close)
lower_wick = math.min(open, close) - low
candle_min_body = 0.3
significant_candle = body > (atr_safe * candle_min_body)

is_hammer = significant_candle and lower_wick >= (2 * body) and upper_wick < (body * 0.5)
is_engulf_buy = close > open and close > open[1] and open < close[1] and body > body[1] * 1.2 and significant_candle
is_star = significant_candle and upper_wick >= (2 * body) and lower_wick < (body * 0.5)
is_engulf_sell = close < open and close < open[1] and open > close[1] and body > body[1] * 1.2 and significant_candle

// ✅ CORRECCIÓN: Asegurar booleanos (evitar 'na')
patron_buy = safe_bool(is_hammer) or safe_bool(is_engulf_buy)
patron_sell = safe_bool(is_star) or safe_bool(is_engulf_sell)

var label[] labels_patron = array.new_label(0)
if patron_buy
    lbl = label.new(bar_index, low, "🕯️", style=label.style_label_up, color=color.green, textcolor=color.white, size=size.tiny)
    array.push(labels_patron, lbl)
    cleanup_labels(labels_patron, 3)
if patron_sell
    lbl = label.new(bar_index, high, "🕯️", style=label.style_label_down, color=color.red, textcolor=color.white, size=size.tiny)
    array.push(labels_patron, lbl)
    cleanup_labels(labels_patron, 3)

bias_bull = inp_use_bias ? (close > d_open) : true
bias_bear = inp_use_bias ? (close < d_open) : true

// ═══════════════════════════════════════════════════════════════════════════════
// 🎚️ CONFLUENCIA
// ═══════════════════════════════════════════════════════════════════════════════
confluence_score_long = 0
confluence_score_short = 0

if use_zone_filter
    confluence_score_long += zona_soporte ? 1 : 0
    confluence_score_short += zona_resist ? 1 : 0
if use_rsi_filter
    confluence_score_long += safe_bool(rsi < rsi_os) ? 1 : 0
    confluence_score_short += safe_bool(rsi > rsi_ob) ? 1 : 0
if use_pattern_filter
    confluence_score_long += patron_buy ? 1 : 0
    confluence_score_short += patron_sell ? 1 : 0
if use_bias_filter
    confluence_score_long += bias_bull ? 1 : 0
    confluence_score_short += bias_bear ? 1 : 0

mandatory_filters_long = close > m15_ema and mercado_vivo and in_session
mandatory_filters_short = close < m15_ema and mercado_vivo and in_session

longCond = mandatory_filters_long and (confluence_score_long >= confluence_min)
shortCond = mandatory_filters_short and (confluence_score_short >= confluence_min)

// ═══════════════════════════════════════════════════════════════════════════════
// 💰 RIESGO
// ═══════════════════════════════════════════════════════════════════════════════
var float daily_loss = 0.0
var int daily_trades_count = 0
if ta.change(time("1D")) != 0
    daily_loss := 0.0
    daily_trades_count := 0

var int consecutive_losses = 0
var float size_multiplier = 1.0
var int last_closed_trades = 0

if strategy.closedtrades > last_closed_trades
    last_trade_profit = strategy.closedtrades.profit(strategy.closedtrades - 1)
    if last_trade_profit < 0
        daily_loss := daily_loss + math.abs(last_trade_profit)
        consecutive_losses += 1
        if reduce_size_after_loss
            size_multiplier := math.max(0.5, 1.0 - (consecutive_losses * 0.2))
    else
        consecutive_losses := 0
        size_multiplier := 1.0
    daily_trades_count += 1
    last_closed_trades := strategy.closedtrades

daily_risk_pct = strategy.equity > 0 ? (daily_loss / strategy.equity * 100) : 0.0
blocked_by_daily_risk = daily_risk_pct >= max_risk_per_day
blocked_by_losses = consecutive_losses >= max_consecutive_losses
blocked_by_daily_limit = daily_trades_count >= max_daily_trades
can_trade = not blocked_by_daily_risk and not blocked_by_losses and not blocked_by_daily_limit

bgcolor(blocked_by_daily_risk ? color.new(color.red, 70) : na, title="Límite Riesgo Diario")

// ═══════════════════════════════════════════════════════════════════════════════
// 🚀 EJECUCIÓN
// ═══════════════════════════════════════════════════════════════════════════════
var int entry_bar = 0
var float entry_price_saved = 0.0
var bool breakeven_activated = false
var bool is_long_position = false
var box[] trade_boxes = array.new_box(0)
var label[] trade_labels = array.new_label(0)

draw_trade_visual(is_long, entry, sl, tp) =>
    right = bar_index + 12
    c_tp_bg = is_long ? color.new(color.green, 90) : color.new(color.red, 90)
    c_tp_border = is_long ? color.green : color.red
    tp_box = box.new(bar_index, entry, right, tp, bgcolor=c_tp_bg, border_color=c_tp_border, border_width=1)
    array.push(trade_boxes, tp_box)
    sl_box = box.new(bar_index, entry, right, sl, bgcolor=color.new(color.red, 85), border_color=color.red, border_width=1)
    array.push(trade_boxes, sl_box)
    txt_emoji = is_long ? "🚀 COMPRA" : "🔻 VENTA"
    lbl_style = is_long ? label.style_label_up : label.style_label_down
    lbl_color = is_long ? color.green : color.red
    lbl_loc = is_long ? (low - atr_safe * 2) : (high + atr_safe * 2)
    rr_text = str.tostring(tp_ratio, "#.#")
    trade_label = label.new(bar_index, lbl_loc, txt_emoji + "\nR:R " + rr_text + ":1", color=lbl_color, style=lbl_style, textcolor=color.white, size=size.small)
    array.push(trade_labels, trade_label)
    cleanup_boxes(trade_boxes, 30)
    cleanup_labels(trade_labels, 15)

get_alert_message(type, p, s, t, qty_pct, risk_usd) =>
    emoji = type == "COMPRA" ? "🚀" : "🔻"
    msg = emoji + " AURUM V35.4\nActivo: " + syminfo.ticker + "\nTipo: " + type + "\nPrecio: " + str.tostring(p, "#.#####") + "\nStop: " + str.tostring(s, "#.#####") + "\nTP: " + str.tostring(t, "#.#####") + "\nRiesgo: $" + str.tostring(risk_usd, "#.##")
    msg

if (longCond and strategy.position_size == 0 and can_trade)
    sl = close - (atr_safe * sl_mult)
    tp = close + ((close - sl) * tp_ratio)
    qty_pct = use_dynamic_sizing ? calc_position_size(close, sl, risk_percent) * size_multiplier : risk_percent * size_multiplier
    risk_usd = strategy.equity * (risk_percent / 100)
    alert_msg = get_alert_message("COMPRA", close, sl, tp, qty_pct, risk_usd)
    strategy.entry("Long", strategy.long, qty=qty_pct, comment="🚀 LONG", alert_message=alert_msg)
    strategy.exit("Exit Long", "Long", stop=sl, limit=tp)
    entry_bar := bar_index
    entry_price_saved := close
    breakeven_activated := false
    is_long_position := true
    draw_trade_visual(true, close, sl, tp)

if (shortCond and strategy.position_size == 0 and can_trade)
    sl = close + (atr_safe * sl_mult)
    tp = close - ((sl - close) * tp_ratio)
    qty_pct = use_dynamic_sizing ? calc_position_size(close, sl, risk_percent) * size_multiplier : risk_percent * size_multiplier
    risk_usd = strategy.equity * (risk_percent / 100)
    alert_msg = get_alert_message("VENTA", close, sl, tp, qty_pct, risk_usd)
    strategy.entry("Short", strategy.short, qty=qty_pct, comment="🔻 SHORT", alert_message=alert_msg)
    strategy.exit("Exit Short", "Short", stop=sl, limit=tp)
    entry_bar := bar_index
    entry_price_saved := close
    breakeven_activated := false
    is_long_position := false
    draw_trade_visual(false, close, sl, tp)

if strategy.position_size != 0 and use_breakeven and not breakeven_activated
    profit_distance = is_long_position ? (close - entry_price_saved) : (entry_price_saved - close)
    if profit_distance >= (atr_safe * breakeven_mult)
        new_sl = entry_price_saved + (syminfo.mintick * 10)
        if is_long_position
            strategy.exit("Exit Long", "Long", stop=new_sl)
        else
            strategy.exit("Exit Short", "Short", stop=new_sl)
        breakeven_activated := true
        be_label = label.new(bar_index, close, "⚡ BE", style=label.style_circle, color=color.orange, textcolor=color.white, size=size.tiny)
        array.push(trade_labels, be_label)

if strategy.position_size != 0 and use_trailing
    profit_distance = is_long_position ? (close - entry_price_saved) : (entry_price_saved - close)
    if profit_distance >= (atr_safe * trail_start)
        trail_stop = is_long_position ? (close - (atr_safe * trail_offset)) : (close + (atr_safe * trail_offset))
        if is_long_position
            strategy.exit("Exit Long", "Long", stop=trail_stop)
        else
            strategy.exit("Exit Short", "Short", stop=trail_stop)

if strategy.position_size != 0
    bars_in_trade = bar_index - entry_bar
    if bars_in_trade >= max_bars_in_trade
        strategy.close_all(comment="⏰ TIME EXIT")
        time_label = label.new(bar_index, close, "⏰", style=label.style_xcross, color=color.orange, textcolor=color.white, size=size.small)
        array.push(trade_labels, time_label)

// ═══════════════════════════════════════════════════════════════════════════════
// 🎨 VISUALIZACIÓN FINAL
// ═══════════════════════════════════════════════════════════════════════════════
plot(m15_ema, "EMA M15", color=COL_TREND, linewidth=2)
plot(inp_use_bias ? d_open : na, "Daily Open", color=COL_DAILY, linewidth=2, style=plot.style_stepline)

if show_dashboard and barstate.islast
    total_trades = strategy.closedtrades
    win_rate = total_trades > 0 ? (strategy.wintrades / total_trades * 100) : 0.0
    profit_factor = strategy.grossloss > 0 ? (strategy.grossprofit / strategy.grossloss) : 0.0
    
    // ✅ CORRECCIÓN DEFINITIVA: Validar bools en patrones
    recent_pattern = (safe_bool(patron_buy) or safe_bool(patron_sell)) or (safe_bool(patron_buy[1]) or safe_bool(patron_sell[1])) or (safe_bool(patron_buy[2]) or safe_bool(patron_sell[2]))

    var table dash = table.new(position.bottom_right, 2, 8, bgcolor=color.new(color.black, 50), border_width=1, border_color=COL_GOLD)
    table.cell(dash, 0, 0, "AURUM V35.4", text_color=COL_GOLD, text_size=size.normal)
    table.cell(dash, 1, 0, "PATCHED ✅", text_color=color.lime, text_size=size.small)
    table.cell(dash, 0, 1, "Win Rate", text_color=color.white)
    table.cell(dash, 1, 1, str.tostring(win_rate, "#.#") + "%", text_color=win_rate>=50?color.green:color.red)
    table.cell(dash, 0, 2, "Profit Factor", text_color=color.white)
    table.cell(dash, 1, 2, str.tostring(profit_factor, "#.##"), text_color=profit_factor>=1.5?color.green:color.orange)
